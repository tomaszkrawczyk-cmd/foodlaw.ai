---
import type { Translation } from '../i18n/translations';

interface Props {
  t: Translation;
}

const { t } = Astro.props;

const screenshots = [
  {
    src: '/images/app-claims.webp',
    width: 1280,
    height: 720,
    caption: t.gallery.items[0],
    overlayText: 'app.foodlaw.ai',
    url: 'https://app.foodlaw.ai',
  },
  {
    src: '/images/nutrimetr.webp',
    width: 1280,
    height: 720,
    caption: t.gallery.items[1],
    overlayText: 'Nutrimetr',
    url: 'https://nutrimetr.foodlaw.ai',
  },
  {
    src: '/images/supplemental-ai.webp',
    width: 1280,
    height: 720,
    caption: t.gallery.items[2],
    overlayText: 'supplemental.pl',
    url: 'https://supplemental.pl',
  },
  {
    src: '/images/rej-hero.webp',
    width: 1600,
    height: 840,
    caption: t.gallery.items[3],
    overlayText: 'REJ',
    url: '/rej/',
  },
];
---

<section id="gallery" class="py-20 px-4 sm:px-6 lg:px-8 bg-gray-50">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-primary-700 mb-4">
        {t.gallery.title}
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        {t.gallery.subtitle}
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {screenshots.map((item) => {
        const external = item.url.startsWith('http');
        return (
          <a
            href={item.url}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
            class="screenshot-card group"
          >
            <div class="screenshot-container">
              <span class="screenshot-overlay" aria-hidden="true">{item.overlayText}</span>
              <img
                src={item.src}
                alt={item.caption}
                width={item.width}
                height={item.height}
                loading="lazy"
                decoding="async"
                class="screenshot-img"
              />
            </div>
            <p class="mt-3 text-sm text-gray-600 text-center font-medium group-hover:text-primary-700 transition-colors">
              {item.caption}
            </p>
          </a>
        );
      })}
    </div>
  </div>
</section>
