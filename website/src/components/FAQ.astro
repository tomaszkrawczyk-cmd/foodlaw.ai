---
import type { Translation } from '../i18n/translations';
import { faqs } from '../data/geo';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
const lang = t.lang === 'en' ? 'en' : 'pl';
const items = faqs[lang];
const prefix = lang === 'pl' ? '/faq/' : '/en/faq/';
const more = lang === 'pl' ? 'Pełna odpowiedź →' : 'Full answer →';
const all = lang === 'pl' ? 'Wszystkie pytania' : 'All questions';
---

<section id="faq" class="py-20 px-4 sm:px-6 lg:px-8 bg-primary-50">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-primary-700 mb-4">
        {t.faq.title}
      </h2>
      <p class="text-gray-600">
        <a href={prefix} class="text-primary-700 font-semibold hover:underline">{all} →</a>
      </p>
    </div>
    <div class="space-y-6">
      {items.map((item) => (
        <article class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <h3 class="text-lg font-semibold text-primary-900 mb-2">
            <a href={`${prefix}${item.slug}/`} class="hover:underline">{item.question}</a>
          </h3>
          <p class="text-gray-600">{item.answer.slice(0, 180)}…</p>
          <p class="mt-3">
            <a href={`${prefix}${item.slug}/`} class="text-sm font-semibold text-accent-700 hover:underline">{more}</a>
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
