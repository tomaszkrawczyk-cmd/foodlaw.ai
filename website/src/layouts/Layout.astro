---
import '../styles/global.css';
import type { Translation } from '../i18n/translations';
import { NAP } from '../data/geo';

interface Props {
  t: Translation;
  pageTitle?: string;
  pageDescription?: string;
  canonical?: string;
  hreflangPl?: string;
  hreflangEn?: string;
}

const { t, pageTitle, pageDescription, canonical, hreflangPl, hreflangEn } = Astro.props;
const title = pageTitle || t.meta.title;
const description = pageDescription || t.meta.description;
const canonicalUrl = canonical || t.meta.canonical;
const ogLocale = t.lang === 'pl' ? 'pl_PL' : 'en_US';
const altLocale = t.lang === 'pl' ? 'en_US' : 'pl_PL';
const hlPl = hreflangPl || 'https://foodlaw.ai/';
const hlEn = hreflangEn || 'https://foodlaw.ai/en/';
---

<!doctype html>
<html lang={t.lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={t.meta.keywords} />
    <meta name="ai-description" content={t.meta.aiDescription} />
    <meta name="author" content="Tomasz Krawczyk" />
    <meta name="geo.region" content="PL-MZ" />
    <meta name="geo.placename" content="Warszawa" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="pl" href={hlPl} />
    <link rel="alternate" hreflang="en" href={hlEn} />
    <link rel="alternate" hreflang="x-default" href="https://foodlaw.ai/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="text/plain" href="https://foodlaw.ai/llms.txt" title="LLM index" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={t.meta.ogImage} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={altLocale} />
    <meta property="og:site_name" content="FOODLAW.ai" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": NAP.org,
      "url": NAP.url,
      "email": NAP.email,
      "telephone": NAP.phone,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": NAP.streetAddress,
        "postalCode": NAP.postalCode,
        "addressLocality": NAP.addressLocality,
        "addressRegion": NAP.addressRegion,
        "addressCountry": NAP.addressCountry
      },
      "founder": {
        "@type": "Person",
        "name": NAP.name,
        "url": "https://supplemental.pl/o-mnie/"
      },
      "description": "AI-powered platform for EU and Polish food law: health claims, notifications, labelling, novel food.",
      "sameAs": NAP.sameAs
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": NAP.name,
      "jobTitle": "Legal counsel — EU and Polish food law",
      "url": "https://supplemental.pl/o-mnie/",
      "email": NAP.email,
      "telephone": NAP.phone,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": NAP.streetAddress,
        "postalCode": NAP.postalCode,
        "addressLocality": NAP.addressLocality,
        "addressCountry": NAP.addressCountry
      },
      "worksFor": { "@type": "Organization", "name": NAP.org, "url": NAP.url },
      "sameAs": NAP.sameAs
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": NAP.org,
      "url": NAP.url,
      "image": "https://foodlaw.ai/favicon.svg",
      "telephone": NAP.phone,
      "email": NAP.email,
      "areaServed": ["PL", "EU"],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": NAP.streetAddress,
        "postalCode": NAP.postalCode,
        "addressLocality": NAP.addressLocality,
        "addressRegion": NAP.addressRegion,
        "addressCountry": NAP.addressCountry
      },
      "founder": { "@type": "Person", "name": NAP.name },
      "knowsAbout": [
        "food law",
        "health claims Regulation 1924/2006",
        "novel food Regulation 2015/2283",
        "dietary supplements GIS notification",
        "food labelling Regulation 1169/2011"
      ]
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "FOODLAW.ai",
      "url": "https://foodlaw.ai",
      "inLanguage": ["pl", "en"],
      "description": "AI-powered food law assistant covering 19+ areas of EU and Polish food regulation.",
      "publisher": { "@type": "Organization", "name": NAP.org, "url": NAP.url },
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://app.foodlaw.ai/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "FOODLAW.ai",
          "item": "https://foodlaw.ai/"
        },
        ...(t.lang === 'en' ? [{
          "@type": "ListItem",
          "position": 2,
          "name": "English",
          "item": "https://foodlaw.ai/en/"
        }] : [])
      ]
    })} />

    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "app.foodlaw.ai (Claims)",
        "url": "https://app.foodlaw.ai",
        "applicationCategory": "LegalApplication",
        "description": "Search engine and analysis tool for EU nutrition and health claims regulated under Regulation 1924/2006.",
        "operatingSystem": "Web",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "PLN" }
      },
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Nutrimetr",
        "url": "https://nutrimetr.foodlaw.ai",
        "applicationCategory": "LegalApplication",
        "description": "Food and food law analysis tool for ingredient verification, label checks, and regulatory compliance assessment.",
        "operatingSystem": "Web"
      },
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "ODS AI",
        "applicationCategory": "LegalApplication",
        "description": "AI assistant for preparing appeals against Polish sanitary inspection authority (Sanepid) decisions in food law matters.",
        "operatingSystem": "Web"
      }
    ])} />
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <slot />
  </body>
</html>
