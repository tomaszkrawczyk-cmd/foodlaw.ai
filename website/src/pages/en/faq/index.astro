---
import InnerChrome from '../../../components/InnerChrome.astro';
import { translations } from '../../../i18n/translations';
import { faqs, faqPageLd, faqIndexUrl, crumbs } from '../../../data/geo';

const t = translations.en;
const items = faqs.en;
---

<InnerChrome
  t={t}
  pageTitle="FAQ — EU and Polish food law | FOODLAW.ai"
  pageDescription="Answers: GIS supplement notification, health claims 1924/2006, novel food, RASFF, labelling."
  canonical={faqIndexUrl('en')}
  hreflangPl={faqIndexUrl('pl')}
  hreflangEn={faqIndexUrl('en')}
  crumbs={crumbs('en', [{ name: 'FAQ', item: faqIndexUrl('en') }])}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqPageLd('en', faqIndexUrl('en'), items))} />

  <nav class="text-sm text-primary-600 mb-4" aria-label="Breadcrumb">
    <a href="/en/" class="hover:underline">FOODLAW.ai</a> / FAQ
  </nav>
  <h1 class="text-3xl sm:text-4xl font-bold text-primary-800 mb-4">Frequently asked questions</h1>
  <p class="text-gray-600 mb-10">
    Each question has its own URL for search and AI citation. Topic hubs:
    <a class="text-primary-700 font-semibold hover:underline" href="/en/hubs/">/en/hubs/</a>.
  </p>
  <ul class="space-y-5">
    {items.map((item) => (
      <li class="border border-gray-100 rounded-xl p-5 bg-primary-50/50">
        <a href={`/en/faq/${item.slug}/`} class="text-lg font-semibold text-primary-900 hover:underline">{item.question}</a>
        <p class="text-gray-700 mt-2 leading-relaxed">{item.answer}</p>
      </li>
    ))}
  </ul>
</InnerChrome>
